# Copy to .env and fill in. Never commit .env.

# OpenRouter key for sentence generation (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional: video source for step6/step7 — webcam index (0) or path to a video file
# PSL_VIDEO_SOURCE=0

# Optional: override default locations (defaults are relative to fyp/)
# PSL_RAW_DIR=/path/to/raw/videos
# PSL_MODEL_PATH=models/best_model.pth

# Optional: API server bind address
# PSL_HOST=0.0.0.0
# PSL_PORT=5000
